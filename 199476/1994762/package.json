{
  "name": "ssq-forecast",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "generate": "node scripts/generate-react-runtime.mjs",
    "verify": "node scripts/verify-ssq.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "npm run generate && npm run verify && tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "html-react-parser": "^5.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
